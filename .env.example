# --- LLM (any OpenAI-compatible endpoint) ---
# Gemini via AI Studio (free tier): https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Optional. Gemini accepts low | medium | high. Leave empty for Groq / Ollama.
LLM_REASONING_EFFORT=low
# Free tiers are rate limited per minute. Keep this a little under your quota.
LLM_REQUESTS_PER_MINUTE=8

# Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a tool-calling model from console.groq.com/docs/models>
# Groq's free tier limits tokens per minute (e.g. 8,000 TPM for openai/gpt-oss-120b) and an agent
# call is ~1k tokens, so stay near 6 requests/min; 429s are retried after the server's retry-after.
# LLM_REQUESTS_PER_MINUTE=6
# Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# --- Sources ---
FHIR_BASE_URL=https://r4.smarthealthit.org
PATIENT_COUNT=30

# --- Delivery ---
# Leave empty to let the pipeline start the mock CRM itself on CRM_PORT.
CRM_URL=
CRM_PORT=4010

# --- Runtime ---
# The LLM rate limit is shared across records; 1-2 is plenty on a free tier.
RECORD_CONCURRENCY=3
LOG_LEVEL=info
